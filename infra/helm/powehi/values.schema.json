{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Powehi Helm values schema",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "tag": { "type": "string" }
      }
    },
    "region": {
      "type": "string",
      "enum": ["eu-frankfurt", "ap-seoul", "ap-tokyo", ""]
    },
    "tier": {
      "type": "string",
      "enum": ["Tier1", "Tier2"],
      "description": "Region tier: Tier1=full R/W primary, Tier2=read-replica relay (prd.md §4A)"
    },
    "config": {
      "type": "object",
      "properties": {
        "logLevel": {
          "type": "string",
          "enum": ["error", "warn", "info", "debug", "trace"]
        },
        "grpcTlsEnabled": {
          "type": "boolean"
        },
        "databaseMaxConnections": {
          "type": "integer",
          "minimum": 1
        },
        "r2RequestTimeoutSecs": {
          "type": "integer",
          "minimum": 1
        },
        "mediaGcSweepTimeoutSecs": {
          "type": "integer",
          "minimum": 1
        },
        "mediaOrphanSweepGraceHours": {
          "type": "integer",
          "minimum": 1
        },
        "mediaOrphanSweepTimeoutSecs": {
          "type": "integer",
          "minimum": 1
        },
        "mediaOrphanSweepEnabled": {
          "type": "boolean",
          "description": "Kill switch for the orphan sweep background job. Flip to false to stop it without a code revert (e.g. during a DB restore or a suspected bucket misconfiguration)."
        },
        "mediaOrphanSweepMaxDeletesPerRun": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000,
          "description": "Blast-radius cap: max objects the orphan sweep may delete in a single 6-hourly tick."
        },
        "r2Endpoint": {
          "type": "string"
        },
        "r2Bucket": {
          "type": "string"
        },
        "vapidContact": {
          "type": "string"
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "resources": {
      "type": "object",
      "required": ["limits", "requests"],
      "properties": {
        "limits": {
          "type": "object",
          "required": ["cpu", "memory"]
        },
        "requests": {
          "type": "object",
          "required": ["cpu", "memory"]
        }
      }
    },
    "externalSecrets": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "refreshInterval": { "type": "string" },
        "secretStoreRef": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "kind": { "type": "string", "minLength": 1 }
          }
        },
        "remoteRefs": {
          "type": "object",
          "properties": {
            "databaseUrl": { "type": "string", "minLength": 1 },
            "redisUrl": { "type": "string", "minLength": 1 },
            "r2AccessKeyId": { "type": "string", "minLength": 1 },
            "r2SecretAccessKey": { "type": "string", "minLength": 1 },
            "vapidPrivateKey": { "type": "string", "minLength": 1 },
            "grpcTlsCert": { "type": "string", "minLength": 1 },
            "grpcTlsKey": { "type": "string", "minLength": 1 },
            "grpcTlsCa": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h|d|w|y)$" },
            "scrapeTimeout": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h|d|w|y)$" },
            "additionalLabels": {
              "type": "object",
              "additionalProperties": { "type": "string" },
              "description": "Labels copied onto the ServiceMonitor object so a Prometheus Operator selector (e.g. release: kube-prometheus-stack) picks it up. A typo here silently drops all scraping with no CI-visible failure."
            }
          }
        },
        "prometheusRule": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "window": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h|d|w|y)$",
              "description": "Prometheus duration literal for the increase() lookback window (e.g. \"1h\"). Malformed values make Prometheus reject the whole rule group, silently dropping both alerts."
            },
            "additionalLabels": {
              "type": "object",
              "additionalProperties": { "type": "string" },
              "description": "Labels copied onto the PrometheusRule object so a Prometheus Operator ruleSelector (e.g. release: kube-prometheus-stack) picks it up. A typo here silently drops both alerts with no CI-visible failure."
            }
          }
        }
      }
    }
  }
}
